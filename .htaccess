# SPA rewrite support for React Router paths
Options -MultiViews
RewriteEngine On
RewriteBase /

# Serve existing files and directories normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect all other requests to index.html so React Router can handle routes
RewriteRule ^ index.html [L]

# Custom 404 fallback for static hosting
ErrorDocument 404 /404.html
